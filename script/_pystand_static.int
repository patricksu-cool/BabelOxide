import sys
import os
import pathlib
import asyncio
import multiprocessing

# PyStand loads this file from the EXE directory. Set the path before importing
# pdf2zh_next so config constants also resolve correctly in child processes.
os.environ["PDF2ZH_APP_DIR"] = str(pathlib.Path(__file__).resolve().parent)

import pdf2zh_next.main
import babeldoc.assets.assets
from pdf2zh_next.security_logging import is_sensitive_field
from pdf2zh_next.security_logging import redact_text
from pdf2zh_next.security_logging import register_secret_values

# Register command-line credentials before startup so even an early launcher
# exception cannot echo an API key in the unhandled traceback.
for index, argument in enumerate(sys.argv[1:], start=1):
    option, has_value, inline_value = argument.partition("=")
    if is_sensitive_field(option.lstrip("-")):
        value = inline_value if has_value else (
            sys.argv[index + 1] if index + 1 < len(sys.argv) else ""
        )
        register_secret_values({option: value})

WAIT_FOR_INPUT = False
if len(sys.argv) == 1:
    sys.argv.append("--gui")  # 无参数时自动添加 -i 参数
    WAIT_FOR_INPUT = True

multiprocessing.set_executable(os.path.join(os.path.dirname(__file__), 'runtime', 'pythonw.exe'))

files = os.listdir(os.path.dirname(__file__))
for file in files:
    if file.endswith(".zip") and file.startswith("offline_assets_"):
        print('find offline_assets_zip file: ', file, ' try restore...')
        babeldoc.assets.assets.restore_offline_assets_package(pathlib.Path(os.path.dirname(__file__)))

try:
    code = asyncio.run(pdf2zh_next.main.main())
    print(f"pdf2zh_next.main.main() return code: {code}")
    if WAIT_FOR_INPUT:
        input("Press Enter to continue...")
    sys.exit(code)
except KeyboardInterrupt:
    # asyncio.run has already cancelled pending tasks and closed its loop.
    # Keep an intentional console interruption out of the fatal-error path.
    print("Interrupted by user.", file=sys.stderr)
    sys.exit(130)
except Exception as exc:
    import traceback
    print(
        redact_text("".join(traceback.format_exception(exc))),
        file=sys.stderr,
    )
    if WAIT_FOR_INPUT:
        input("Press Enter to continue...")
    sys.exit(1)
